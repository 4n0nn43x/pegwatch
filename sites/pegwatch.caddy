pegwatch.fyra.fun {
	import secure
	# Raw archives stay private: they hold P2P advertiser nicknames and weigh up to ~80 MB a day each.
	# Only the computed JSON (world.json, ladder/, fixing/, premiums/latest.json, monday/, evidence/) is public.
	@raw path *.jsonl *.jsonl.gz *.gz.tmp
	handle @raw {
		respond 404
	}
	handle /mcp* {
		reverse_proxy pegwatch-web:8081
	}
	handle {
		reverse_proxy pegwatch-web:8080
	}
}
